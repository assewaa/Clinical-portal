[Unit]
Description=Clinical Systems Portal (Django)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Documents/Clinical-portal
EnvironmentFile=/etc/clinical-portal.env
ExecStart=/home/ubuntu/Documents/Clinical-portal/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8002 --access-logfile - --error-logfile - config.wsgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
